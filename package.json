{
  "name": "@allenyolk/pi-minimal-display",
  "version": "0.1.0",
  "publishConfig": { "access": "public" },
  "description": "Compact, expandable Pi tool cards with reversible presentation patches.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/AllenYolk/pi-minimal-display.git" },
  "files": ["src", "README.md", "LICENSE"],
  "exports": "./src/index.ts",
  "pi": { "extensions": ["./src/index.ts"] },
  "keywords": ["pi-package", "pi", "tool-rendering"],
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "benchmark": "npm run build && node test/benchmark.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
